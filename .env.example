# Postgres (Neon — use the pooled connection string from Vercel Storage / Neon dashboard)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Postgres table namespace (simplycode_users, etc.) — NOT a Vercel/Neon env var prefix.
DB_TABLE_PREFIX="simplycode"

NEXT_PUBLIC_APP_NAME="Simply Code"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public URL of the app (local: http://localhost:3000)
AUTH_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# UploadThing — https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=""

# Public site URL (used for canonical URLs, sitemap, robots and Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google Workspace / Gmail SMTP — use an App Password, not the account password.
# Google Account > Security > 2-Step Verification > App passwords.
GOOGLE_SMTP_USER=""
GOOGLE_SMTP_APP_PASSWORD=""
CONTACT_EMAIL="hello@simplycode.io"
# Optional. Defaults to GOOGLE_SMTP_USER; set only for an authorised Google alias.
# CONTACT_FROM_EMAIL="Simply Code <hello@simplycode.io>"
